# --- Core ---
PORT=5000
NODE_ENV=development
# Where the SQLite file lives. In production, point this at a persistent volume/disk —
# see DEPLOYMENT.md for why this matters and how to set it up on common hosts.
DATABASE_PATH=./data/quotation.db

# --- Auth ---
# REQUIRED in production. A long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Bootstrap admin account, created automatically on first boot if no users exist yet.
# If left unset, a random password is generated and printed to the server log ONCE —
# fine for local dev, but set these explicitly for any real deployment.
ADMIN_EMAIL=admin@geely.local
ADMIN_NAME=Beheerder
ADMIN_PASSWORD=

# --- CORS (only matters if frontend and backend run as separate services, e.g. local dev) ---
FRONTEND_URL=http://localhost:3000

# --- E-mail (optional — "Verstuur naar klant" is disabled until these are set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
